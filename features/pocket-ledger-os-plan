#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Documents/pocket-ledger-os-session-plans"
file="$HOME/Documents/pocket-ledger-os-session-plans/plan-$(date +%Y%m%d-%H%M%S).md"
{
 printf '# pocket-ledger-os session plan\n\n'
 printf 'Created: %s\n\n' "$(date -Is)"
 printf 'Purpose: personal finance\n\n## Prompts\n'
 printf '%s\n' '- What work item will you finish?' '- What is the next concrete action?' '- What records, approvals, or deadline matter?'
 printf '\n## Notes\n'
} > "$file"
nano "$file"
printf 'Saved locally: %s\n' "$file"
